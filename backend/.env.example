# ==============================================================================
# Codify Backend Environment Variables Example
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# DATABASE (PostgreSQL - e.g., Neon.tech)
# Example: jdbc:postgresql://ep-xyz.ap-southeast-1.aws.neon.tech/neondb
DB_URL=jdbc:postgresql://your-database-host:port/dbname
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# REDIS (e.g., Redis Labs or Local)
# Example: redis://default:password@host:port
REDIS_URL=redis://your-redis-url

# GOOGLE OAUTH
# Obtain these from Google Cloud Console (Credentials section)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# KAFKA (e.g., Aiven or Local)
# Example: host:port
KAFKA_BOOTSTRAP_SERVERS=your-kafka-broker:port

# KAFKA SSL (If using SSL-enabled Kafka like Aiven)
# These are required if spring.kafka.security.protocol is set to SSL
KAFKA_TRUSTSTORE_PASSWORD=your_truststore_password
KAFKA_KEYSTORE_PASSWORD=your_keystore_password
KAFKA_KEY_PASSWORD=your_key_password

# GROQ AI (For code analysis)
# Obtain from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key

# SENDGRID
SENDGRID_API_KEY=your_sendgrid_api_key

# JWT
JWT_SECRET=your_jwt_secret_hex_string

